{
  "name": "@apnex/entity-store",
  "version": "0.0.0",
  "private": true,
  "description": "Keep typed, tagged entities in a single order of changes that every read can be dated against.",
  "license": "MIT",
  "author": "apnex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apnex/entity-store.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./file-storage": {
      "types": "./dist/file-storage-adapter.d.ts",
      "default": "./dist/file-storage-adapter.js"
    },
    "./contract-suite": {
      "types": "./dist/contract-suite.d.ts",
      "default": "./dist/contract-suite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "docs:check": "tools/check-docs.sh"
  },
  "dependencies": {
    "@apnex/shape-check": "file:../shape-check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
